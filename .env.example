# Vyxo Codex 2.0 - Environment Variables
# Copy this file to .env.local and fill in your values

# ==================================
# Supabase Configuration
# ==================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==================================
# Application Configuration
# ==================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ==================================
# AI Services
# ==================================
# OpenAI (for quiz question generation)
OPENAI_API_KEY=sk-your-openai-key

# Google AI (optional alternative)
GOOGLE_AI_API_KEY=your-google-ai-key

# Anthropic Claude (optional alternative)
ANTHROPIC_API_KEY=your-anthropic-key

# ==================================
# Email Service (Resend)
# ==================================
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=noreply@vyxo-codex.com

# ==================================
# Push Notifications (optional)
# ==================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@vyxo-codex.com

# ==================================
# Monitoring & Analytics (optional)
# ==================================
# Sentry
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ==================================
# Security
# ==================================
# Session secret for additional security
SESSION_SECRET=your-random-session-secret-min-32-chars

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://vyxo-codex.vercel.app

# ==================================
# Rate Limiting
# ==================================
# Redis URL for distributed rate limiting (optional)
REDIS_URL=redis://localhost:6379

# ==================================
# Feature Flags (optional)
# ==================================
FEATURE_AI_QUESTIONS=true
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_TEAM_CHALLENGES=true
FEATURE_EXPORT_DATA=true

# ==================================
# Deployment
# ==================================
# Vercel
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-org-id
VERCEL_PROJECT_ID=your-project-id

# Supabase (for migrations)
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# ==================================
# Development
# ==================================
# Enable debug logging
DEBUG=false

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1
